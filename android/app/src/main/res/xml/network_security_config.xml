<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Exigencia de HTTPS en todas las comunicaciones del sistema (Criterio de aceptación).
      En producción el tráfico en texto plano (HTTP sin cifrar) está completamente deshabilitado.
      Todas las conexiones requieren TLS/HTTPS con certificados válidos del sistema.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
