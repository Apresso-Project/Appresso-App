# Copia este archivo como ".env" (en esta misma carpeta, backend/) y cambia la contraseña.
# El archivo ".env" NO se sube al repositorio. Este ".env.example" sí.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=appresso
DB_USER=appresso
DB_PASSWORD=cambia_esta_clave

# Clave con la que el backend firma los tokens de sesión. Debe tener 32 caracteres o más y ser
# distinta en cada entorno. El valor de ejemplo es corto a propósito: si no lo cambias, el
# backend no arranca. Genera una con: openssl rand -base64 48
JWT_SECRET=cambia_esta_clave

# --- Solo para desarrollo local (NUNCA en un servidor) ---
# Con este perfil activo, al arrancar el backend crea un administrador de prueba (si no existe) con
# el correo y la contraseña de abajo. La clave "spring.profiles.active" va en minusculas y con
# puntos, tal cual; las demas, en mayusculas. Cambia la contraseña por una tuya.
spring.profiles.active=dev
DEV_ADMIN_CORREO=admin@appresso.test
DEV_ADMIN_CONTRASENA=cambia_esta_clave
